-0.0075325327925384045, 0.006745276972651482, -0.035948194563388824, 0.06720864027738571, 0.03799252584576607, -0.007276918739080429, -0.006243532057851553, 0.008022435940802097, -0.026444554328918457, 0.04407570883631706, -0.01989779807627201, 0.010021938011050224, 0.011238430626690388, 0.005697565618902445, 0.024730008095502853, 0.028254594653844833, 0.022019246593117714, 0.016620155423879623, 0.01887691766023636, 0.04532349854707718, 0.007916802540421486, -0.036058686673641205, -0.010218044742941856, 0.045250169932842255, 0.0147017203271389, 0.010692945681512356, -0.01751420646905899, 0.05591597780585289, -0.034405555576086044, -0.02249755710363388, 0.016751227900385857, 0.004281717352569103, -0.05588373914361, -0.011175250634551048, 0.018901485949754715, 0.002186350990086794, 0.02022806741297245, 0.04284941032528877, 0.037485674023628235, -0.01686588115990162, -0.007443195674568415, -0.027155498042702675], metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16', 'document_title': '《中华人民共和国刑法》总则概览：基本原则、适用范围与刑事责任\n\n这个标题综合了您提供的各个子标题内容，涵盖了刑法的基本原则、适用范围（包括国际条约和域外犯罪）、以及关于刑事责任年龄与过失犯罪的规定等关键点。这样的标题能够较好地概括整个文档的主题，适合用于介绍或学习《中华人民共和国刑法》总则部分的整体框架与核心内容。'}, excluded_embed_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], excluded_llm_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], relationships={<NodeRelationship.SOURCE: '1'>: RelatedNodeInfo(node_id='ef730adf-8b0b-4bb9-9fb1-dd7b08a0c2b3', node_type='4', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='2fc1866ab8091c4db808af6ebf89d6595b5a2e03c403a398796a63b864ecc2cf'), <NodeRelationship.PREVIOUS: '2'>: RelatedNodeInfo(node_id='2869e5b7-7bec-4717-89ee-c06eee978cbc', node_type='1', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='4fd4765a094860de01c5d9c7274a09396613189510a73dccf310572f05f3bb5d'), <NodeRelationship.NEXT: '3'>: RelatedNodeInfo(node_id='18d19f19-e459-4006-b5d2-065ace78c13a', node_type='1', metadata={}, hash='a278ee8093be696bc2e72b1a0d5c7e051fbde5ea01c62076b199bf9e769cf943')}, metadata_template='{key}: {value}', metadata_separator='\n', text='第八十条\u3000无期徒刑减为有期徒刑的刑期，从裁定减刑之日起计算。\r\n\r\n第七节\u3000假释\r\n\r\n第八十一条\u3000被判处有期徒刑的犯罪分子，执行原判刑期二分之一以上，被判处无期徒刑的犯罪分子，实际执行十三年以上，如果认真遵守监规，接受教育改造，确有悔改表现，没有再犯罪的危险的，可以假释。如果有特殊情况，经最高人民法院核准，可以不受上述执行刑期的限制。\r\n对累犯以及因故意杀人、强奸、抢劫、绑架、放火、爆炸、投放危险物质或者有组织的暴力性犯罪被判处十年以上有期徒刑、无期徒刑的犯罪分子，不得假释。\r\n对犯罪分子决定假释时，应当考虑其假释后对所居住社区的影响。\r\n第八十二条\u3000对于犯罪分子的假释，依照本法第七十九条规定的程序进行。非经法定程序不得假释。', mimetype='text/plain', start_char_idx=8500, end_char_idx=8818, metadata_seperator='\n', text_template='[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n'), score=0.1483257), NodeWithScore(node=TextNode(id_='f47f62cf-f9b2-402f-af5a-98a98f1f4f36', embedding=[-0.029463503509759903, 0.026859207078814507, 0.02113262005150318, -0.059266090393066406, 0.03779909759759903, 0.05234720930457115, 0.021949568763375282, -0.0052971988916397095, -0.01930500566959381, 0.016249140724539757, -0.007959075272083282, -0.0019938857294619083, 0.018884945660829544, -0.021386127918958664, 0.006379285827279091, 0.0028043980710208416, -0.020793871954083443, 0.03353874757885933, -0.004740281030535698, -0.0220