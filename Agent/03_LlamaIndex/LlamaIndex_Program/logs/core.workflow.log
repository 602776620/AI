83, -0.06232995167374611, -0.00018658212502487004, 0.01708853803575039, -0.0019043665379285812, 0.018900001421570778, 0.03590795025229454, 0.034066811203956604, -0.02125694416463375, -0.00208153179846704, -0.041345711797475815], metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16', 'document_title': '《中华人民共和国刑法》总则概览：基本原则、适用范围与刑事责任\n\n这个标题综合了您提供的各个子标题内容，涵盖了刑法的基本原则、适用范围（包括国际条约和域外犯罪）、以及关于刑事责任年龄与过失犯罪的规定等关键点。这样的标题能够较好地概括整个文档的主题，适合用于介绍或学习《中华人民共和国刑法》总则部分的整体框架与核心内容。'}, excluded_embed_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], excluded_llm_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], relationships={<NodeRelationship.SOURCE: '1'>: RelatedNodeInfo(node_id='ef730adf-8b0b-4bb9-9fb1-dd7b08a0c2b3', node_type='4', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='2fc1866ab8091c4db808af6ebf89d6595b5a2e03c403a398796a63b864ecc2cf'), <NodeRelationship.PREVIOUS: '2'>: RelatedNodeInfo(node_id='b7aaa3a5-4a4b-4fcf-934a-1ad353eddfb1', node_type='1', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='e082ae490d430bd3181125ad16dfcb2301c7ddf980d15d2723c5e0f3953b8c19'), <NodeRelationship.NEXT: '3'>: RelatedNodeInfo(node_id='af0de384-fdce-4770-8817-57a9060642b9', node_type='1', metadata={}, hash='bbc84ac1ad4886c7f14715efb843cda615e2784e59ef3b5624cbb1692c3503bb')}, metadata_template='{key}: {value}', metadata_separator='\n', text='减刑以后实际执行的刑期不能少于下列期限：\r\n（一）判处管制、拘役、有期徒刑的，不能少于原判刑期的二分之一；\r\n（二）判处无期徒刑的，不能少于十三年；\r\n（三）人民法院依照本法第五十条第二款规定限制减刑的死刑缓期执行的犯罪分子，缓期执行期满后依法减为无期徒刑的，不能少于二十五年，缓期执行期满后依法减为二十五年有期徒刑的，不能少于二十年。\r\n第七十九条\u3000对于犯罪分子的减刑，由执行机关向中级以上人民法院提出减刑建议书。人民法院应当组成合议庭进行审理，对确有悔改或者立功事实的，裁定予以减刑。非经法定程序不得减刑。\r\n第八十条\u3000无期徒刑减为有期徒刑的刑期，从裁定减刑之日起计算。', mimetype='text/plain', start_char_idx=8243, end_char_idx=8530, metadata_seperator='\n', text_template='[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n'), score=0.37856212), NodeWithScore(node=TextNode(id_='5bd5107b-f5c6-4a4b-952a-be15a731539b', embedding=[-0.028269018977880478, 0.020354149863123894, 0.018514225259423256, -0.05295561999082565, 0.026846494525671005, 0.03274369239807129, 0.01613876037299633, 0.00933881662786007, -0.023485463112592697, 0.010996806435286999, -0.0032680428121238947, -0.008723730221390724, 0.026599165052175522, -0.024021701887249947, -0.005103103816509247, -0.01493794471025467, -0.03000209853053093, 0.03668464347720146, -0.012219492346048355, -0.024501506239175797, 0.02212418243288994, -0.024110404774546623, -0.012675896286964417, 0.025995321571826935, 0.02054259367287159, 0.006934014614671469, -0.03132251277565956, -0.01061688456684351, 0.07183884084224701, 0.01046979520469904, -0.03324538841843605, -0.005813682917505503, -0.007386474404484034, 0.02746618539094925, 0.04828820005059242, -0.015282640233635902, 0.011593637987971306, 0.033727820962667465, 0.009427406825125217, 0.010326119139790535, 0.014380846172571182, 0.020026523619890213, 0.020365679636597633, -0.02893144264817238, 0.01925031840801239, 0.011716775596141815, -0.007015316281467676, 0.024088924750685692, 0.030296847224235535, 0.02157544158399105, -0.005272133741527796, 0.0411340706050396, 0.007857544347643852, 0.0