40450859, 0.037433043122291565, -0.02982482872903347, -0.02356666512787342, 0.006377788260579109, 0.021068738773465157, -0.05256589874625206, -0.016999129205942154, 0.011366263031959534, 0.004795221146196127, 0.011137624271214008, 0.04281028360128403, 0.04578562080860138, -0.01692950911819935, -0.002183767734095454, -0.026032865047454834], metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16', 'document_title': '《中华人民共和国刑法》总则概览：基本原则、适用范围与刑事责任\n\n这个标题综合了您提供的各个子标题内容，涵盖了刑法的基本原则、适用范围（包括国际条约和域外犯罪）、以及关于刑事责任年龄与过失犯罪的规定等关键点。这样的标题能够较好地概括整个文档的主题，适合用于介绍或学习《中华人民共和国刑法》总则部分的整体框架与核心内容。'}, excluded_embed_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], excluded_llm_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], relationships={<NodeRelationship.SOURCE: '1'>: RelatedNodeInfo(node_id='ef730adf-8b0b-4bb9-9fb1-dd7b08a0c2b3', node_type='4', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='2fc1866ab8091c4db808af6ebf89d6595b5a2e03c403a398796a63b864ecc2cf'), <NodeRelationship.PREVIOUS: '2'>: RelatedNodeInfo(node_id='d72e5d28-09f2-46b1-9379-d8f100c6547b', node_type='1', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='05c1c50b340602fc285b0c6e2e1578a7ccf240beca4a960956a95540895af074'), <NodeRelationship.NEXT: '3'>: RelatedNodeInfo(node_id='b7aaa3a5-4a4b-4fcf-934a-1ad353eddfb1', node_type='1', metadata={}, hash='44a10d33976bbbafbfd80c24a2c1eeb122e405bc34c5113b182710a2316b595c')}, metadata_template='{key}: {value}', metadata_separator='\n', text='第七十七条\u3000被宣告缓刑的犯罪分子，在缓刑考验期限内犯新罪或者发现判决宣告以前还有其他罪没有判决的，应当撤销缓刑，对新犯的罪或者新发现的罪作出判决，把前罪和后罪所判处的刑罚，依照本法第六十九条的规定，决定执行的刑罚。\r\n被宣告缓刑的犯罪分子，在缓刑考验期限内，违反法律、行政法规或者国务院有关部门关于缓刑的监督管理规定，或者违反人民法院判决中的禁止令，情节严重的，应当撤销缓刑，执行原判刑罚。', mimetype='text/plain', start_char_idx=7809, end_char_idx=8004, metadata_seperator='\n', text_template='[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n'), score=0.02119999)] 
2025-06-16 16:19:55,239 - core.workflow - INFO - 开始生成回答
2025-06-16 16:20:02,130 - core.workflow - INFO - 回答生成完成=>在服刑期间，如果犯罪分子能够认真遵守监规，接受教育改造，并且有明显的悔改表现，或者有立功表现，可以申请减刑。具体来说，如果有以下重大立功表现之一的，应当予以减刑：
- 阻止他人实施重大犯罪活动；
- 检举监狱内外的重大犯罪活动，并且查证属实；
- 有发明创造或重大技术革新；
- 在日常生产、生活中舍己救人；
- 在抗御自然灾害或排除重大事故中有突出表现；
