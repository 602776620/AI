file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='2fc1866ab8091c4db808af6ebf89d6595b5a2e03c403a398796a63b864ecc2cf'), <NodeRelationship.PREVIOUS: '2'>: RelatedNodeInfo(node_id='f47f62cf-f9b2-402f-af5a-98a98f1f4f36', node_type='1', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='0908af158dc0c886e331eb5ba178141ea366878839ae5740891f3c4fdcfb53d5'), <NodeRelationship.NEXT: '3'>: RelatedNodeInfo(node_id='2869e5b7-7bec-4717-89ee-c06eee978cbc', node_type='1', metadata={}, hash='a39e5e617b8932a2f8267f720483b8875ccd0507f644e04c605605ac8055e33d')}, metadata_template='{key}: {value}', metadata_separator='\n', text='第六节\u3000减刑\r\n\r\n第七十八条\u3000被判处管制、拘役、有期徒刑、无期徒刑的犯罪分子，在执行期间，如果认真遵守监规，接受教育改造，确有悔改表现的，或者有立功表现的，可以减刑；有下列重大立功表现之一的，应当减刑：\r\n（一）阻止他人重大犯罪活动的；\r\n（二）检举监狱内外重大犯罪活动，经查证属实的；\r\n（三）有发明创造或者重大技术革新的；\r\n（四）在日常生产、生活中舍己救人的；\r\n（五）在抗御自然灾害或者排除重大事故中，有突出表现的；\r\n（六）对国家和社会有其他重大贡献的。', mimetype='text/plain', start_char_idx=8008, end_char_idx=8241, metadata_seperator='\n', text_template='[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n'), score=0.9350998), NodeWithScore(node=TextNode(id_='2869e5b7-7bec-4717-89ee-c06eee978cbc', embedding=[-0.016206752508878708, 0.035951584577560425, 0.002616714918985963, -0.03829265385866165, 0.0331193283200264, 0.035272203385829926, 0.018532130867242813, -0.009048191830515862, -0.0014980003470554948, 0.02242676354944706, -0.022342627868056297, -0.014517167583107948, 0.00984852947294712, -0.03095877543091774, -0.006108861416578293, -0.019691186025738716, -0.023315612226724625, 0.04065749794244766, -0.019354665651917458, -0.0008653326658532023, 0.03454502299427986, -0.04188992828130722, -0.002209917176514864, 0.024859344586730003, 0.