5632305070757866, -0.034073613584041595, -0.015037121251225471, -0.001119402702897787, -0.046768635511398315, -0.005320549011230469, 0.011964204721152782, -0.017160791903734207, 0.017716743052005768, 0.04617660120129585, 0.041367918252944946, -0.01032936293631792, -0.0031356406398117542, -0.028491947799921036], metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16', 'document_title': '《中华人民共和国刑法》总则概览：基本原则、适用范围与刑事责任\n\n这个标题综合了您提供的各个子标题内容，涵盖了刑法的基本原则、适用范围（包括国际条约和域外犯罪）、以及关于刑事责任年龄与过失犯罪的规定等关键点。这样的标题能够较好地概括整个文档的主题，适合用于介绍或学习《中华人民共和国刑法》总则部分的整体框架与核心内容。'}, excluded_embed_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], excluded_llm_metadata_keys=['file_name', 'file_type', 'file_size', 'creation_date', 'last_modified_date', 'last_accessed_date'], relationships={<NodeRelationship.SOURCE: '1'>: RelatedNodeInfo(node_id='ef730adf-8b0b-4bb9-9fb1-dd7b08a0c2b3', node_type='4', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='2fc1866ab8091c4db808af6ebf89d6595b5a2e03c403a398796a63b864ecc2cf'), <NodeRelationship.PREVIOUS: '2'>: RelatedNodeInfo(node_id='6ab128e1-80cd-46a2-aaf7-656e2ec3e31f', node_type='1', metadata={'file_path': 'C:\\Users\\拯救者R9000P\\AppData\\Local\\Temp\\gradio\\0471b7db8c182d7ba69f519ee75da592ba6dd5dda71aa29023a60d42146fd398\\中华人民共和国刑法.txt', 'file_name': '中华人民共和国刑法.txt', 'file_type': 'text/plain', 'file_size': 213575, 'creation_date': '2025-06-12', 'last_modified_date': '2025-06-16'}, hash='ad9104c80f5207cde9d263080cca1e55e2e4c5cde49950e28e7048f8aa0b7dee'), <NodeRelationship.NEXT: '3'>: RelatedNodeInfo(node_id='676b6b8c-5cd2-4371-a0fe-927c6dda3548', node_type='1', metadata={}, hash='02fe86c4e2acc3704c49949bf5ce396861557e63356c0f64f25d9337128e6919')}, metadata_template='{key}: {value}', metadata_separator='\n', text='对被判处死刑缓期执行的累犯以及因故意杀人、强奸、抢劫、绑架、放火、爆炸、投放危险物质或者有组织的暴力性犯罪被判处死刑缓期执行的犯罪分子，人民法院根据犯罪情节等情况可以同时决定对其限制减刑。\r\n第五十一条\u3000死刑缓期执行的期间，从判决确定之日起计算。死刑缓期执行减为有期徒刑的刑期，从死刑缓期执行期满之日起计算。\r\n\r\n第六节\u3000罚金\r\n\r\n第五十二条\u3000判处罚金，应当根据犯罪情节决定罚金数额。\r\n第五十三条\u3000罚金在判决指定的期限内一次或者分期缴纳。期满不缴纳的，强制缴纳。对于不能全部缴纳罚金的，人民法院在任何时候发现被执行人有可以执行的财产，应当随时追缴。\r\n由于遭遇不能抗拒的灾祸等原因缴纳确实有困难的，经人民法院裁定，可以延期缴纳、酌情减少或者免除。', mimetype='text/plain', start_char_idx=4849, end_char_idx=5175, metadata_seperator='\n', text_template='[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n'), score=0.16202626), NodeWithScore(node=TextNode(id_='a861fd43-9251-41d0-a489-62b9563285df', embedding=[-0.037094902247190475, 0.04436222091317177, 0.016463596373796463, -0.07371370494365692, 0.03026825189590454, 0.037895604968070984, 0.014260949566960335, 0.01383224967867136, -0.02989695779979229, 0.008050243370234966, -0.02619978040456772, -0.0017699493328109384, 0.009190481156110764, 0.009190836921334267, -0.012495978735387325, 0.014047441072762012, -0.026891043409705162, -0.011329603381454945, -0.0033070321660488844, -0.012641231529414654, 0.043005455285310745, -0.036225926131010056, -0.01233610138297081, 0.036948103457689285, 0.013948917388916016, 0.02778039500117302, -0.006923555862158537, -0.019981347024440765, 0.06587693095207214, 0.007313897367566824, -0.03667096421122551, -0.0067092860117554665, 0.015232721343636513, 0.014785069972276688, 0.06609305739402771, -0.003865649690851569, 0.006810288410633802, 0.008339391089975834, 0.016936639323830605, -0.0034480772446841, 0.012569212354719639, 0.03003809228539467, 0.001217892044223845, -0.026356633752584457, 0.02640659362077713, 0.03772392496466637, -0.0154613964259